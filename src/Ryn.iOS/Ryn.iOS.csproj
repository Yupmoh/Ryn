<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>Ryn.iOS</RootNamespace>
    <Description>iOS WebKit host and ViewController integration for Ryn</Description>
    <PackageTags>ryn;ios;mobile;webkit;webview</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CA1416;CA1062;CA1031;CA1308;CA1307;CA2000;IL2026;CS0067;CA1050;CA1515;CA1010;CA2213</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ryn.Core\Ryn.Core.csproj" />
    <ProjectReference Include="..\Ryn.Ipc\Ryn.Ipc.csproj" />
  </ItemGroup>
</Project>
