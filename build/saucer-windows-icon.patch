 #include "utils/wide.hpp"
 
+#ifdef _WIN32
+#include <windows.h>
+#include <gdiplus.h>
+#endif
+
+namespace
+{
+#ifdef _WIN32
+    static_assert(sizeof(ULONG_PTR) == sizeof(saucer_icon::gdiplus_token));
+
+    saucer_icon *new_initialized_icon(auto &&factory, int *error)
+    {
+        Gdiplus::GdiplusStartupInput input{};
+        ULONG_PTR token{};
+        const auto status = Gdiplus::GdiplusStartup(&token, &input, nullptr);
+
+        if (status != Gdiplus::Status::Ok)
+        {
+            if (error)
+            {
+                *error = static_cast<int>(status);
+            }
+
+            return nullptr;
+        }
+
+        auto rtn = factory();
+
+        if (!rtn.has_value())
+        {
+            if (error)
+            {
+                *error = rtn.error().code();
+            }
+
+            Gdiplus::GdiplusShutdown(token);
+            return nullptr;
+        }
+
+        return new saucer_icon{std::move(*rtn), static_cast<unsigned long long>(token)};
+    }
+#endif
+} // namespace
